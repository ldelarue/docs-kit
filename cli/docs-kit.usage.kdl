// @generated by usage-spec-typer from Typer metadata
name docs-kit
bin docs-kit
about "docs-kit command line: init / refresh / spec / render / check / pull-tasks / serve.\n\nDoc generation is pure file I/O; the subprocesses are the task-layer syncs\n(init's best-effort shim update and `pull-tasks`, which shell out to git),\n`serve` (Zensical), and `spec`/`render`: `spec` runs the Typer exporter that\nlives inside this package's venv (dependency mode puts docs-kit - and with it\nusage-spec-typer - in the CONSUMER's venv, so `uv run docs-kit spec` imports\nthe repo's own app), and `render` calls the `usage` binary from PATH (pinned\nby the committed glue block's `[tools]` line).\n\nWhat a repository gets is autodetected at every command: an OpenAPI pipeline\nwhen `openapi.json` (or --spec) is there, a CLI-reference pipeline when CLI\nevidence is (`cli/*.usage.kdl`, a Typer app in pyproject, cobra in go.mod),\nboth when both are. `docs-kit init --with-mise --committed` (dependency mode)\nwrites the committed mise.toml task block; from then on `spec` (contracts),\n`render` (reference pages) and `refresh`/`check` (both, plus API pages) run\nentirely inside this CLI. Without --committed - and on shim/no-venv consumers\never - the task layer (`shared/mise/docs.toml` + the `.docs-kit` shim) drives\nthese same commands and the shared render/usage-spec payload scripts. Drift\nis gated by `docs:check` as usual.\n"
long_about "docs-kit command line: init / refresh / spec / render / check / pull-tasks / serve.\n\nDoc generation is pure file I/O; the subprocesses are the task-layer syncs\n(init's best-effort shim update and `pull-tasks`, which shell out to git),\n`serve` (Zensical), and `spec`/`render`: `spec` runs the Typer exporter that\nlives inside this package's venv (dependency mode puts docs-kit - and with it\nusage-spec-typer - in the CONSUMER's venv, so `uv run docs-kit spec` imports\nthe repo's own app), and `render` calls the `usage` binary from PATH (pinned\nby the committed glue block's `[tools]` line).\n\nWhat a repository gets is autodetected at every command: an OpenAPI pipeline\nwhen `openapi.json` (or --spec) is there, a CLI-reference pipeline when CLI\nevidence is (`cli/*.usage.kdl`, a Typer app in pyproject, cobra in go.mod),\nboth when both are. `docs-kit init --with-mise --committed` (dependency mode)\nwrites the committed mise.toml task block; from then on `spec` (contracts),\n`render` (reference pages) and `refresh`/`check` (both, plus API pages) run\nentirely inside this CLI. Without --committed - and on shim/no-venv consumers\never - the task layer (`shared/mise/docs.toml` + the `.docs-kit` shim) drives\nthese same commands and the shared render/usage-spec payload scripts. Drift\nis gated by `docs:check` as usual."
flag --version help="show program's version number and exit"
cmd init help="scaffold a Zensical docs site in a repo" {
    flag --spec help="OpenAPI spec file relative to root (default: openapi.json when present; the API pipeline is skipped when it is not)" {
        arg <SPEC>
    }
    flag --bin help="name a CLI binary explicitly (repeatable); otherwise CLIs are detected from cli/*.usage.kdl, typer console scripts, or go.mod+cobra" var=#true {
        arg <BIN>
    }
    flag --no-api help="never run the OpenAPI pipeline, even when openapi.json is present"
    flag --no-cli help="never run the CLI-reference pipeline, even when CLI evidence is present"
    flag --force help="overwrite scaffold files" negate=--no-force
    flag --with-mise help="add mise integration (shim mode: pulls the .docs-kit task layer and wires the docs:* tasks through mise.local.toml)" negate=--no-with-mise
    flag --committed help="with --with-mise: dependency mode - write the canonical [tools] usage + docs task block into the repo's mise.toml (committed; requires docs-kit to be a dev dependency here)" negate=--no-committed
    flag --docs-kit help="path recorded as vars.docs_kit (default: $DOCS_KIT or the .docs-kit shim; pass a clone path for checkout mode)" {
        arg <DOCS_KIT>
    }
    arg "[root]" help="target repo (default: cwd)" required=#false default=.
}
cmd spec help="regenerate cli/<bin>.usage.kdl contracts from the code behind them" {
    flag --bin help="name a CLI binary explicitly (repeatable); otherwise CLIs are detected from cli/*.usage.kdl, typer console scripts, or go.mod+cobra" var=#true {
        arg <BIN>
    }
    flag --extra help="curated extra .kdl file (default: cli/<bin>.usage.extra.kdl when present; single-contract runs only)" {
        arg <EXTRA>
    }
    flag --out help="write the contract here instead of cli/<bin>.usage.kdl (single-contract runs only)" {
        arg <OUT>
    }
    flag --no-cli help="never run the CLI-reference pipeline, even when CLI evidence is present"
    arg "[root]" help="target repo (default: cwd)" required=#false default=.
}
cmd render help="render docs/references/cli/<bin>.md from the committed usage contracts" {
    arg "[root]" help="target repo (default: cwd)" required=#false default=.
}
cmd refresh help="regenerate all generated docs files" {
    flag --spec help="OpenAPI spec file relative to root (default: openapi.json when present; the API pipeline is skipped when it is not)" {
        arg <SPEC>
    }
    flag --bin help="name a CLI binary explicitly (repeatable); otherwise CLIs are detected from cli/*.usage.kdl, typer console scripts, or go.mod+cobra" var=#true {
        arg <BIN>
    }
    flag --no-api help="never run the OpenAPI pipeline, even when openapi.json is present"
    flag --no-cli help="never run the CLI-reference pipeline, even when CLI evidence is present"
    arg "[root]" help="target repo (default: cwd)" required=#false default=.
}
cmd check help="fail if generated docs files are stale" {
    flag --spec help="OpenAPI spec file relative to root (default: openapi.json when present; the API pipeline is skipped when it is not)" {
        arg <SPEC>
    }
    flag --bin help="name a CLI binary explicitly (repeatable); otherwise CLIs are detected from cli/*.usage.kdl, typer console scripts, or go.mod+cobra" var=#true {
        arg <BIN>
    }
    flag --no-api help="never run the OpenAPI pipeline, even when openapi.json is present"
    flag --no-cli help="never run the CLI-reference pipeline, even when CLI evidence is present"
    arg "[root]" help="target repo (default: cwd)" required=#false default=.
}
cmd pull-tasks help="pin the .docs-kit task layer to this CLI's version" {
    arg "[root]" help="target repo (default: cwd)" required=#false default=.
}
cmd serve help="serve the docs with live reload (Zensical)" {
    flag --port help="exact port to bind (default: $DOCS_PORT, else prefer 8010, then first free port in $FREE_PORT_MIN-$FREE_PORT_MAX)" {
        arg <PORT>
    }
    flag --host help="bind address (default: 127.0.0.1)" default="127.0.0.1" {
        arg <HOST>
    }
    arg "[root]" help="target repo (default: cwd)" required=#false default=.
}

config {
  prop "docs_kit" type="string" default=".docs-kit" help="Where the shared/mise task layer lives: a repo-local shim dir (pulled by init) or an absolute path to a docs-kit clone. --docs-kit overrides." { env "DOCS_KIT" }
  prop "docs_kit_repo" type="string" default="git@github.com:ldelarue/docs-kit.git" help="Git URL the .docs-kit task layer is fetched from; set it to a file:// URL or mirror to pull the layer from somewhere else." { env "DOCS_KIT_REPO" }
  prop "docs_kit_skip_pull" type="bool" default="false" help="Any value makes init/refresh skip the best-effort task-layer sync (tests and offline runs)." { env "DOCS_KIT_SKIP_PULL" }
  prop "docs_port" type="int" default=0 help="Exact port for docs-kit serve; pins the server with no port hunting (serve exits 1 unless it can bind this one)." { env "DOCS_PORT" }
  prop "free_port_min" type="int" default="8000" help="Lower bound of the leased port range when nothing is pinned; must be an integer." { env "FREE_PORT_MIN" }
  prop "free_port_max" type="int" default="8999" help="Upper bound of the leased port range when nothing is pinned; must be an integer." { env "FREE_PORT_MAX" }
  prop "no_color" type="bool" default="false" help="Suppresses the init/refresh ANSI colours even on a terminal." { env "NO_COLOR" }
}
exit_code 0 "Command succeeded (check prints all files up to date)"
exit_code 1 "Generated docs stale or missing (check), task-layer sync failure (pull-tasks), port lease exhausted, or bad env values"
exit_code 2 "Usage error: missing subcommand, unknown flag, invalid --port"
example """
docs-kit init --with-mise --bin mycli   # CLI-only scaffold + the docs:* mise tasks
docs-kit refresh                        # regenerate pages, vendored spec, CI workflow
docs-kit check                          # the drift gate: exit 1 + fix hint on stale docs
docs-kit serve --port 8010              # live-reload preview on a pinned port
docs-kit pull-tasks                     # re-pin .docs-kit/ to the installed CLI's tag
"""
