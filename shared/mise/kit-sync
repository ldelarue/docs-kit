#!/bin/sh
# Canonical engine behind the consumer-side docs:pull-tasks task: aligns (or
# creates) a docs-kit task-layer shim checkout (sparse: /shared/mise/ only)
# with the INSTALLED CLI version, so the tasks in shared/mise/docs.toml can
# never drift from the CLI build. This file is itself part of the pulled
# payload, so consumers pick up engine updates by pulling the layer.
# Usage: sh kit-sync [SHIM_DIR] [VERSION]   defaults: .docs-kit, auto-detected.
# Requires: git (SSH access to the kit repo), and either a docs-kit binary on
# PATH or a uv project for the fallback probe (unless VERSION is given).

set -eu

SHIM="${1:-.docs-kit}"
REPO="git@github.com:ldelarue/docs-kit.git"

if [ "$#" -ge 2 ]; then
	ver="$2"
else
	ver="$({ docs-kit --version 2>/dev/null || uv run --no-dev docs-kit --version; } 2>/dev/null | awk '{print $2}')"
	if [ -z "${ver:-}" ]; then
		printf 'kit-sync: no docs-kit on PATH and no uv project here; install the CLI or pass VERSION\n' >&2
		exit 1
	fi
fi
v="v$ver"

if [ ! -d "$SHIM" ]; then
	git clone -q -c advice.detachedHead=false --depth 1 --branch "$v" \
		--filter=blob:none --sparse "$REPO" "$SHIM"
	git -C "$SHIM" -c advice.detachedHead=false sparse-checkout set --no-cone '/shared/mise/'
	printf 'docs task layer pinned at %s\n' "$v"
	exit 0
fi

if [ "$(git -C "$SHIM" describe --tags --exact-match 2>/dev/null || true)" != "$v" ]; then
	git -C "$SHIM" fetch -q --depth 1 origin "+refs/tags/$v:refs/tags/$v"
	git -C "$SHIM" -c advice.detachedHead=false checkout -q "$v"
fi
git -C "$SHIM" -c advice.detachedHead=false sparse-checkout set --no-cone '/shared/mise/' 2>/dev/null || true
printf 'docs task layer pinned at %s\n' "$v"
