#!/bin/sh
# Render docs/references/cli/<bin>.md from cli/<bin>.usage.kdl using the
# `usage` binary. Called by the docs:refresh / docs:check tasks (docs.toml)
# AFTER `mise run cli:spec` has (re)generated the contracts; safe stand-alone:
# with no cli/*.usage.kdl committed it is a no-op.
#
# For every contract this does, in order:
#   usage lint              - a broken contract fails the pipeline (standard §3)
#   usage generate markdown - the reader page, banner-prefixed
# Output is byte-stable (no timestamps), so docs:check's `git diff --exit-code`
# catches any drift between code, KDL and pages. Never hand-edit the pages.
set -eu

if ! command -v usage >/dev/null 2>&1; then
    echo "render-cli-docs: 'usage' is not on PATH." >&2
    echo "  install it via mise: the docs-kit init block in mise.local.toml pins" >&2
    echo '  [tools] usage = "latest" (docs-kit init --with-mise adds it when a' >&2
    echo "  CLI is detected); or one-off: mise use -g usage@latest" >&2
    exit 1
fi

[ -d cli ] || exit 0
status=0
for kdl in cli/*.usage.kdl; do
    [ -e "$kdl" ] || continue
    case "$kdl" in *.usage.extra.kdl) continue ;; esac
    bin=$(basename "$kdl" .usage.kdl)
    out="docs/references/cli/$bin.md"
    if ! usage lint "$kdl"; then
        echo "render-cli-docs: usage lint failed on $kdl - regenerate with 'mise run cli:spec' (never hand-edit the contract)" >&2
        status=1
        continue
    fi
    mkdir -p "$(dirname "$out")"
    {
        echo "<!-- generated by docs-kit from $kdl - do not edit; mise run docs:refresh -->"
        usage generate markdown -f "$kdl" --out-file -
    } > "$out"
    echo "  rendered $out"
done
exit "$status"
