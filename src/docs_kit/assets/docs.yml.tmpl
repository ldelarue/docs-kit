name: Documentation
on:
  push:
    branches:
      - main
      - master
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  # The runner has no personal docs-kit clone: .mise.toml's [env] DOCS_KIT is a
  # local path that does not exist here. Each job MUST check the kit repo out
  # and override DOCS_KIT, otherwise the docs tasks fail. Create a
  # fine-grained DOCS_KIT_PAT (contents: read on ldelarue/docs-kit) secret for
  # the private kit repo, then add to BOTH jobs (before mise-action):
  #   - uses: actions/checkout@v7
  #     with:
  #       repository: ldelarue/docs-kit
  #       path: .docs-kit
  #       token: ${{ secrets.DOCS_KIT_PAT }}
  #       # ref: v0.1.1     # optional: freeze CI; default = default branch
  #   plus at job level:  env: { DOCS_KIT: ${{ github.workspace }}/.docs-kit }
  # Details: docs-kit ROADMAP.md, Phase 2 step 4.
  check:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: jdx/mise-action@v3
      - uses: actions/cache@v4
        with:
          path: ~/.cache/uv
          key: uv-${{ runner.os }}-${{ github.run_id }}
          restore-keys: uv-${{ runner.os }}-
      - run: mise run docs:check

  deploy:
    if: github.event_name != 'pull_request'
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    permissions:
      contents: read
      pages: write
      id-token: write
    runs-on: ubuntu-latest
    steps:
      - uses: actions/configure-pages@v6
      - uses: actions/checkout@v7
      - uses: jdx/mise-action@v3
      - uses: actions/cache@v4
        with:
          path: ~/.cache/uv
          key: uv-${{ runner.os }}-${{ github.run_id }}
          restore-keys: uv-${{ runner.os }}-
      - run: mise run docs:build
      - uses: actions/upload-pages-artifact@v5
        with:
          path: site
      - uses: actions/deploy-pages@v5
        id: deployment
