name: Documentation
on:
  push:
    branches:
      - main
      - master
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

jobs:
  # CI has no personal clone: the [vars].docs_kit path in .mise.toml does not
  # exist on runners, so the [task_config].includes line is silently skipped
  # and every docs:* task VANISHES (mise reports "no task docs:check found" -
  # not "missing path"). Fix = check out the private kit repo and override the
  # path via mise.local.toml before mise-action runs. Create a fine-grained
  # DOCS_KIT_PAT (contents: read on ldelarue/docs-kit) secret, then add to
  # BOTH jobs (before mise-action):
  #   - uses: actions/checkout@v7
  #     with:
  #       repository: ldelarue/docs-kit
  #       path: .docs-kit
  #       token: ${{ secrets.DOCS_KIT_PAT }}
  #       # ref: v0.1.3     # optional: freeze the kit version in CI
  #   - run: printf '[vars]\ndocs_kit = "%s/.docs-kit"\n' "$GITHUB_WORKSPACE" > mise.local.toml
  # Details: docs-kit ROADMAP.md, Phase 2 step 4.
  check:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: jdx/mise-action@v3
      - uses: actions/cache@v4
        with:
          path: ~/.cache/uv
          key: uv-${{ runner.os }}-${{ github.run_id }}
          restore-keys: uv-${{ runner.os }}-
      - run: mise run docs:check

  deploy:
    if: github.event_name != 'pull_request'
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    permissions:
      contents: read
      pages: write
      id-token: write
    runs-on: ubuntu-latest
    steps:
      - uses: actions/configure-pages@v6
      - uses: actions/checkout@v7
      - uses: jdx/mise-action@v3
      - uses: actions/cache@v4
        with:
          path: ~/.cache/uv
          key: uv-${{ runner.os }}-${{ github.run_id }}
          restore-keys: uv-${{ runner.os }}-
      - run: mise run docs:build
      - uses: actions/upload-pages-artifact@v5
        with:
          path: site
      - uses: actions/deploy-pages@v5
        id: deployment
